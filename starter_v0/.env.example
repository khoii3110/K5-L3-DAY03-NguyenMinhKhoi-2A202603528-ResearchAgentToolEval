# ==========================================
# 1. Model Provider (Chọn 1 trong các provider)
# ==========================================
OPENROUTER_API_KEY=
# Hoặc dùng một trong các provider bên dưới:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Tuỳ chọn Local Model (Ollama):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ==========================================
# 2. Tavily — lookup
# Đăng ký lấy key tại: https://app.tavily.com
# ==========================================
TAVILY_API_KEY=

# ==========================================
# 3. Firecrawl — fetch
# Đăng ký lấy key tại: https://www.firecrawl.dev
# ==========================================
FIRECRAWL_API_KEY=

# ==========================================
# 4. RapidAPI Twitter API45 — timeline, social_search
# Đăng ký lấy key tại: https://rapidapi.com/alexanderxbx/api/twitter-api45
# ==========================================
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com

# ==========================================
# 5. arXiv Bonus — papers, paper_text
# (Không cần API key, chỉ cần user-agent)
# ==========================================
ARXIV_USER_AGENT=AI20k-Day03-Research-Agent/1.0 (NguyenMinhKhoi-2A202603528)

# ==========================================
# 6. Telegram Bonus — send (Tuỳ chọn)
# Tạo bot tại @BotFather trên Telegram
# ==========================================
